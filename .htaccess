# Banco Quetzal - configuración de Apache
Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

# Bloquear archivos sensibles
<FilesMatch "\.(sql|md|log|ini|env|yaml|yml|sh|bak)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(Dockerfile|render\.yaml|\.env.*)$">
  Require all denied
</FilesMatch>
